<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.MainPage">

<VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
    <Label Text="☕ Coffee Calculator" FontSize="32" HorizontalOptions="Center" />

    <Label Text="Coffee (Grams)" />
    <Entry Text="{Binding CoffeeGrams}" Keyboard="Numeric" Placeholder="e.g. 20" />
    
    <Label Text="Water (ml)" />
    <Entry Text="{Binding WaterGrams}" Keyboard="Numeric" Placeholder="e.g. 300" />

    <Label Text="Current Ratio is 1:15" HorizontalOptions="Center" TextColor="Gray" />
</VerticalStackLayout>
</ContentPage>
