<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.MainPage">

<VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

    <Label Text="☕ Coffee Calculator" FontSize="32" HorizontalOptions="Center" />

    <Label Text="Coffee (Units)" />
    <Entry ClassId="Coffee" Text="{Binding CoffeeUnits, TargetNullValue= ''}" TextChanged="OnEntryTextChanged" Keyboard="Numeric" Placeholder="e.g. 20" />
    
    <Label Text="Water (Units)" />
    <Entry ClassId="Water" Text="{Binding WaterUnits, TargetNullValue= ''}" TextChanged="OnEntryTextChanged" Keyboard="Numeric" Placeholder="e.g. 300" />

    <Button Text="Clear All" 
        Command="{Binding ResetCommand}" 
        BackgroundColor="Gray" 
        Margin="0,20,0,0" />

    <Label Text="Select Strength" FontSize="16" HorizontalOptions="Center" />

    <Label Text="{Binding CurrentRatio, StringFormat='Selected Ratio: 1:{0}'}"
           FontSize="20"
           HorizontalOptions="Center" />

    <Picker Title="Select Brew Strength"
            ItemsSource="{Binding AvailableRatios}"
            SelectedItem="{Binding CurrentRatio, Mode=TwoWay}"
            HorizontalOptions="Center"
            WidthRequest="200"
            TextColor="SaddleBrown"
            TitleColor="Gray" />

</VerticalStackLayout>
</ContentPage>

